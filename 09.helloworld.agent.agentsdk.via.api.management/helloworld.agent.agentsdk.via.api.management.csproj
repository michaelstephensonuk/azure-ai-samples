<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- OpenAI client (not Azure) – routes to APIM endpoint directly -->
    <PackageReference Include="OpenAI" Version="2.9.0-beta.1" />

    <!-- Microsoft Agent Framework (MAF) - core abstraction -->
    <PackageReference Include="Microsoft.Agents.AI" Version="1.13.0" />
    <!-- MAF OpenAI provider - adds AsAIAgent() extension on OpenAI ChatClient -->
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.13.0" />

    <!-- Microsoft.Extensions.AI - required for AIFunctionFactory.Create() -->
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.7.0" />

    <!-- OpenTelemetry pipeline -->
    <PackageReference Include="OpenTelemetry" Version="1.16.0" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.16.0" />

    <!-- Application Insights exporter -->
    <PackageReference Include="Azure.Monitor.OpenTelemetry.Exporter" Version="1.8.2" />

    <!-- Configuration -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.9" />
  </ItemGroup>

</Project>
